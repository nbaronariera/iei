<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Fuentes\estaciones.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Fuentes\estacionesEntrega.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Fuentes\estaciones_modificado.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Fuentes\Estacions_ITV.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Fuentes\Estacions_ITVEntrega.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Fuentes\ITV-CAT.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Fuentes\ITV-CATEntrega.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>


	<ItemGroup>
		<Compile Remove="SeleniumTasks\**" />
		<EmbeddedResource Remove="SeleniumTasks\**" />
		<None Remove="SeleniumTasks\**" />
		<Page Remove="SeleniumTasks\**" />
	</ItemGroup>

	<ItemGroup>
	    <PackageReference Include="CsvHelper" Version="33.1.0" />
	    <PackageReference Include="EntityFramework" Version="6.4.4" />
	    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="7.0.0" />
	    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="7.0.0">
		    <PrivateAssets>all</PrivateAssets>
		    <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	    </PackageReference>
	    <PackageReference Include="Selenium.WebDriver" Version="4.38.0" />
	    <PackageReference Include="WebDriverManager" Version="2.17.6" />
	</ItemGroup>
	
</Project>
